# Copy this file to .dev.vars and fill in the key for the provider set in
# src/data/assistant.ts. .dev.vars is git-ignored, so keys never get committed.
# On Cloudflare, add the same key under Worker → Settings → Variables and Secrets.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Claude — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
