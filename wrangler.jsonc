// Cloudflare Workers settings for this site.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  // Cloudflare runtime behaviour to use; bump it when you update wrangler
  "compatibility_date": "2026-10-12",
  "main": "./worker/index.ts",
  "upload_source_maps": true,

  "assets": {
    // any unknown page path serves the site (index.html)
    "not_found_handling": "single-page-application",
    // requests to /api/* go to the Worker (the AI chat) instead of the static files
    "run_worker_first": ["/api/*"]
  },

  // keep request logs in the Cloudflare dashboard (Worker → Observability)
  "observability": {
    "enabled": true
  }
}
